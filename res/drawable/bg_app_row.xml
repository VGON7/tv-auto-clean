<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#17333B" />
            <stroke
                android:width="2dp"
                android:color="#45E0B0" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#12262E" />
            <stroke
                android:width="1dp"
                android:color="#2A5C66" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#0B151C" />
            <stroke
                android:width="1dp"
                android:color="#162832" />
        </shape>
    </item>
</selector>
